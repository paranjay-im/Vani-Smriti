GC_STORE=memory
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
SARVAM_API_KEY=
# Sarvam Voice Agent (see docs/23-sarvam-voice-agent.md). Ids are shown by the agent record / dashboard URL.
SARVAM_ORG_ID=
SARVAM_WORKSPACE_ID=
SARVAM_APP_ID=
SARVAM_APP_VERSION=
# Voice Agents API key (agents dashboard: Settings -> API Key) for browser calls on /live. Not the sk_ speech key.
SARVAM_AGENTS_API_KEY=
# Shared secret the agent's API tools send as X-GC-Token; /sarvam/* routes require it when set
GC_SARVAM_TOKEN=
GC_SARVAM_TEST_GLID=
# Agent intro message shown as the first transcript line on VANI Live (Sarvam's transcript can omit it)
SARVAM_GREETING=
